# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs — check https://ai.google.dev/gemini-api/docs/models for the current names
# if either of these start returning errors (Google renames/retires preview models often).
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

DATABASE_URL=sqlite:///./eldercompanion.db

SNOOZE_MINUTES=10
# A delivered reminder with no response after this long is logged as missed.
# Drop it to 1 if you want to demo a missed dose without waiting 15 minutes.
REMINDER_MISSED_AFTER_MINUTES=15

JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_MINUTES=1440

DEMO_CAREGIVER_EMAIL=demo@eldercompanion.ai
DEMO_CAREGIVER_PASSWORD=demo1234
DEMO_CAREGIVER_NAME=Priya (Demo Caregiver)
DEMO_ELDER_NAME=Grandma Rose

CORS_ORIGINS=http://localhost:3000
